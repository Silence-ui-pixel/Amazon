# Copy to .env.production and replace every CHANGE_ME value before deployment.
POSTGRES_USER=keyword_prod
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=keyword_library

# Public entrypoint.
SERVER_NAME=keywords.example.com
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=/etc/letsencrypt

# Windows ZiNiao Agent reaches this server through a restricted reverse SSH tunnel.
KEYWORD_AGENT_GATEWAY_IP=CHANGE_ME_FROM_KEYWORD_LIBRARY_DOCKER_NETWORK
KEYWORD_AGENT_NETWORK_ID=CHANGE_ME_FROM_KEYWORD_LIBRARY_DOCKER_NETWORK_ID
KEYWORD_BROWSER_AGENT_URL=http://keyword-agent-host:17100
KEYWORD_BROWSER_AGENT_TOKEN=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS

# Text and image analysis both use MIMO 2.6 Pro. Credentials stay in the mounted secret file.
DASHSCOPE_MODEL=openai/mimo-v2.6-pro
DASHSCOPE_VISION_MODEL=openai/mimo-v2.6-pro
DASHSCOPE_SECRET_DIR=/etc/keyword-library/secrets/dashscope
DASHSCOPE_SECRET_GID=61001
