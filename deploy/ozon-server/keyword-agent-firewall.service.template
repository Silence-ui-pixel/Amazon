[Unit]
Description=Keyword Library Agent tunnel firewall
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -ec '/usr/sbin/iptables -N KEYWORD_AGENT_17100 2>/dev/null || true; /usr/sbin/iptables -F KEYWORD_AGENT_17100; while /usr/sbin/iptables -C INPUT -p tcp --dport 17100 -j KEYWORD_AGENT_17100 2>/dev/null; do /usr/sbin/iptables -D INPUT -p tcp --dport 17100 -j KEYWORD_AGENT_17100; done; /usr/sbin/iptables -I INPUT 1 -p tcp --dport 17100 -j KEYWORD_AGENT_17100; /usr/sbin/iptables -A KEYWORD_AGENT_17100 -i __BRIDGE__ -s __SUBNET__ -d __GATEWAY__ -p tcp --dport 17100 -j ACCEPT; /usr/sbin/iptables -A KEYWORD_AGENT_17100 -p tcp --dport 17100 -j REJECT'
ExecStop=/bin/sh -ec 'while /usr/sbin/iptables -C INPUT -p tcp --dport 17100 -j KEYWORD_AGENT_17100 2>/dev/null; do /usr/sbin/iptables -D INPUT -p tcp --dport 17100 -j KEYWORD_AGENT_17100; done; /usr/sbin/iptables -F KEYWORD_AGENT_17100 2>/dev/null || true; /usr/sbin/iptables -X KEYWORD_AGENT_17100 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
