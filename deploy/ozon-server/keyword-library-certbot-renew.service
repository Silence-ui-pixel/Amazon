[Unit]
Description=Renew keyword-library TLS certificate with isolated Certbot container
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/bin/docker run --rm --name keyword-library-certbot-renew -v /etc/letsencrypt:/etc/letsencrypt -v /var/lib/letsencrypt:/var/lib/letsencrypt -v /var/log/letsencrypt:/var/log/letsencrypt -v /var/www/letsencrypt:/var/www/letsencrypt docker.m.daocloud.io/certbot/certbot@sha256:bc93cb710b413e6b456d622f9b0133b3e109c0a78c2ed9976af43d209b0a1805 renew --quiet --cert-name keyword-library.8.134.61.236.sslip.io && /usr/sbin/nginx -t && /usr/bin/systemctl reload nginx'

